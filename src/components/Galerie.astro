---
interface GalerieImage {
  url: string;
  alt?: string;
}

interface Props {
  images?: GalerieImage[];
  instagramUrl?: string;
}

const { images = [], instagramUrl } = Astro.props;

const hauptBilder = images.slice(0, 6);
const mehrBilder  = images.slice(6);
---

{images.length > 0 && (
<section id="galerie" aria-label="Bildergalerie">
  <div class="section-inner">
    <p class="section-label">Eindrücke</p>
    <h2 class="section-title">Bildergalerie</h2>
    <div class="divider" aria-hidden="true"></div>

    <div class="galerie-grid">
      {hauptBilder.map((img) => (
        <div class="galerie-item">
          <img src={img.url} alt={img.alt || 'fein und blumig Galerie'} loading="lazy" />
        </div>
      ))}
    </div>

    {mehrBilder.length > 0 && (
      <div class="mehr-wrap">
        <button class="mehr-btn" id="galerie-mehr-btn">
          Mehr Bilder anzeigen
        </button>
      </div>
    )}
  </div>
</section>
)}

<!-- Modal mit weiteren Bildern -->
{mehrBilder.length > 0 && (
  <div class="modal-overlay" id="galerie-modal" role="dialog" aria-modal="true" aria-label="Weitere Bilder">
    <div class="modal-box">
      <button class="modal-close" id="galerie-modal-close" aria-label="Schließen">✕</button>
      <h2 class="modal-title">Bildergalerie</h2>
      <div class="modal-divider"></div>
      <div class="modal-bilder">
        {mehrBilder.map((img) => (
          <div class="col-item">
            <img
              src={img.url}
              alt={img.alt || 'fein und blumig Galerie'}
              loading="lazy"
              onerror="this.closest('.col-item').style.display='none'"
            />
          </div>
        ))}
      </div>
    </div>
  </div>
)}

{instagramUrl && (
<div class="insta-block2">
  <div style="max-width:1100px;margin:0 auto;text-align:center;">
    <p class="insta-text2">Noch mehr Bilder finden Sie auf unserem Instagram-Kanal</p>
    <a href={instagramUrl} target="_blank" rel="noopener" class="insta-btn">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
      </svg>
      @feinundblumig auf Instagram
    </a>
  </div>
</div>
)}

<style>
  #galerie { background: var(--rose-pale); }

  /* ── Hauptraster: 6 Bilder mit individuellen Proportionen ── */
  .galerie-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-areas:
      "a b c"
      "d e f";
    gap: 0.75rem;
  }
  .galerie-item {
    overflow: hidden; border-radius: 2px;
    background: linear-gradient(135deg, var(--rose-soft), var(--rose-pale));
  }
  .galerie-item img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease; }
  .galerie-item:hover img { transform: scale(1.04); }

  .galerie-item:nth-child(1) { grid-area: a; aspect-ratio: 1 / 1; }
  .galerie-item:nth-child(2) { grid-area: b; aspect-ratio: 4 / 3; }
  .galerie-item:nth-child(3) { grid-area: c; aspect-ratio: 1 / 1; }
  .galerie-item:nth-child(4) { grid-area: d; aspect-ratio: 3 / 4; }
  .galerie-item:nth-child(5) { grid-area: e; aspect-ratio: 4 / 3; }
  .galerie-item:nth-child(6) { grid-area: f; aspect-ratio: 1 / 1; }

  /* ── "Mehr Bilder anzeigen" Button ── */
  .mehr-wrap { text-align: center; margin-top: 2rem; }
  .mehr-btn {
    padding: 0.8rem 2.4rem;
    background: transparent; border: 1px solid var(--rose-mid); border-radius: 2px;
    color: var(--rose-deep); font-family: 'Jost', sans-serif;
    font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase;
    cursor: pointer; transition: background 0.2s, border-color 0.2s;
  }
  .mehr-btn:hover { background: var(--rose-soft); border-color: var(--rose-deep); }

  /* ── Modal ── */
  .modal-overlay {
    display: none; position: fixed; inset: 0; z-index: 200;
    background: rgba(58,46,46,0.55); backdrop-filter: blur(4px);
    align-items: center; justify-content: center; padding: 1.5rem;
  }
  .modal-overlay.open { display: flex; }
  .modal-box {
    background: var(--cream); border-radius: 2px;
    max-width: 780px; width: 100%; max-height: 88vh; overflow-y: auto;
    padding: 3rem; position: relative;
    box-shadow: 0 30px 60px rgba(58,46,46,0.2);
  }
  .modal-close {
    position: absolute; top: 1.2rem; right: 1.2rem;
    background: none; border: none; cursor: pointer;
    font-size: 1.42rem; color: var(--bark-light); transition: color 0.2s;
  }
  .modal-close:hover { color: var(--rose-deep); }
  .modal-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.92rem; font-weight: 300; font-style: italic;
    color: var(--bark); margin-bottom: 0.5rem;
  }
  .modal-divider { width: 40px; height: 1px; background: var(--rose-mid); margin-bottom: 1.8rem; }

  /* CSS Columns – wie Leistungen */
  .modal-bilder { columns: 2; column-gap: 1rem; }
  .col-item { break-inside: avoid; margin-bottom: 1rem; }
  .col-item img { width: 100%; height: auto; display: block; border-radius: 2px; }

  /* ── Instagram ── */
  .insta-block2 { background: var(--white); padding: 2.5rem 2rem 3rem; text-align: center; }
  .insta-text2 {
    font-family: 'Cormorant Garamond', serif; font-style: italic;
    font-size: 1.2rem; color: var(--bark-light); margin-bottom: 1.2rem;
  }
  .insta-btn {
    display: inline-flex; align-items: center; gap: 0.7rem;
    padding: 0.9rem 2rem; background: var(--rose-deep); color: white;
    border-radius: 2px; text-decoration: none;
    font-family: 'Jost', sans-serif; font-size: 0.8rem;
    letter-spacing: 0.12em; text-transform: uppercase; transition: background 0.2s;
  }
  .insta-btn:hover { background: var(--rose-dark); }

  @media (max-width: 640px) {
    .galerie-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-areas: none;
    }
    .galerie-item:nth-child(1),
    .galerie-item:nth-child(2),
    .galerie-item:nth-child(3),
    .galerie-item:nth-child(4),
    .galerie-item:nth-child(5),
    .galerie-item:nth-child(6) { grid-area: auto; aspect-ratio: 1 / 1; }
    .modal-box { padding: 1.8rem; }
    .modal-bilder { columns: 1; }
  }
</style>

<script>
  const openBtn = document.getElementById('galerie-mehr-btn');
  const overlay = document.getElementById('galerie-modal');
  const closeBtn = document.getElementById('galerie-modal-close');

  function openGalerie() { overlay?.classList.add('open'); document.body.style.overflow = 'hidden'; }
  function closeGalerie() { overlay?.classList.remove('open'); document.body.style.overflow = ''; }

  openBtn?.addEventListener('click', openGalerie);
  closeBtn?.addEventListener('click', closeGalerie);
  overlay?.addEventListener('click', (e) => { if (e.target === overlay) closeGalerie(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeGalerie(); });
</script>
