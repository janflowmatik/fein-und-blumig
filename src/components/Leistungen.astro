---
interface Bild { url: string; alt: string; }
interface LeistungTexte { titel?: string; karteText?: string; }

interface Props {
  bilder?: {
    hochzeit:  Bild[];
    geschenke: Bild[];
    pflanzen:  Bild[];
    straeuse:  Bild[];
  };
  texte?: {
    hochzeit:  LeistungTexte;
    geschenke: LeistungTexte;
    pflanzen:  LeistungTexte;
    straeuse:  LeistungTexte;
  };
}

const { bilder, texte } = Astro.props;

function absaetze(text: string): string[] {
  return text.split(/\n\n+/).map(p => p.trim()).filter(Boolean);
}

const leistungen = [
  {
    key: 'hochzeit',
    title: texte?.hochzeit?.titel     ?? 'Hochzeitsfloristik',
    karte: texte?.hochzeit?.karteText ?? 'Floraler Schmuck für Ihren schönsten Tag – vom Brautstrauß bis zur Tischdekoration, zart und unvergesslich.',
    bilder: bilder?.hochzeit ?? [],
  },
  {
    key: 'geschenke',
    title: texte?.geschenke?.titel     ?? 'Geschenke für sich selbst und andere',
    karte: texte?.geschenke?.karteText ?? 'Schöne Dinge für Haus und Garten, die Freude machen – ob Geburtstag, Genesung oder einfach so.',
    bilder: bilder?.geschenke ?? [],
  },
  {
    key: 'pflanzen',
    title: texte?.pflanzen?.titel     ?? 'Pflanzen und Dekoriertes',
    karte: texte?.pflanzen?.karteText ?? 'Topfpflanzen und Dekorationen für innen und außen – schick gestaltet nach der Natur als Vorbild.',
    bilder: bilder?.pflanzen ?? [],
  },
  {
    key: 'straeuse',
    title: texte?.straeuse?.titel     ?? 'Schnittblumen und Sträuße',
    karte: texte?.straeuse?.karteText ?? 'Frisch angelieferte Schnittblumen aus ganz Europa – individuell gebunden nach Ihren Wünschen.',
    bilder: bilder?.straeuse ?? [],
  },
];
---

<section id="leistungen" aria-label="Leistungen">
  <div class="section-inner">
    <p class="section-label">Was wir anbieten</p>
    <h2 class="section-title">Unsere Leistungen</h2>
    <div class="divider" aria-hidden="true"></div>
    <div class="karten-grid">
      {leistungen.map((l) => (
        <button class="karte" data-modal={l.key} aria-label={`${l.title} – Bilder ansehen`}>
          <h3 class="karte-title">{l.title}</h3>
          {absaetze(l.karte).map(p => <p class="karte-text">{p}</p>)}
          <p class="karte-more">Bilder ansehen →</p>
        </button>
      ))}
    </div>
  </div>
</section>

{leistungen.map((l) => (
  <div class="modal-overlay" id={`modal-${l.key}`} role="dialog" aria-modal="true" aria-label={l.title}>
    <div class="modal-box">
      <button class="modal-close" data-close aria-label="Schließen">✕</button>
      <h2 class="modal-title">{l.title}</h2>
      <div class="modal-divider"></div>
      {absaetze(l.karte).map(p => <p class="modal-text">{p}</p>)}

      {l.bilder.length > 0 && (
        <div class="modal-bilder" data-leistung={l.key}>
          {l.bilder.map((img) => (
            <div class="col-item">
              <img
                data-src={img.url}
                alt={img.alt || l.title}
                onerror="this.closest('.col-item').style.display='none'"
              />
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
))}

<style>
  #leistungen { background: var(--rose-pale); }
  .karten-grid {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem; margin-top: 1rem;
  }
  .karte {
    background: var(--white); border-radius: 2px; padding: 2.5rem;
    border: 1px solid var(--rose-soft); text-align: left; cursor: pointer;
    transition: box-shadow 0.2s, transform 0.2s;
    font-family: 'Jost', sans-serif;
  }
  .karte:hover { box-shadow: 0 8px 32px var(--shadow); transform: translateY(-3px); }
  .karte-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.3rem; font-weight: 400; color: var(--bark); margin-bottom: 0.8rem;
  }
  .karte-text { font-size: 0.95rem; line-height: 1.7; color: var(--bark-light); }
  .karte-more { font-size: 0.75rem; color: var(--rose-deep); margin-top: 0.8rem; letter-spacing: 0.1em; }

  /* Modal */
  .modal-overlay {
    display: none; position: fixed; inset: 0; z-index: 200;
    background: rgba(58,46,46,0.55); backdrop-filter: blur(4px);
    align-items: center; justify-content: center; padding: 1.5rem;
  }
  .modal-overlay.open { display: flex; }
  .modal-box {
    background: var(--cream); border-radius: 2px;
    max-width: 780px; width: 100%; max-height: 88vh; overflow-y: auto;
    padding: 3rem; position: relative;
    box-shadow: 0 30px 60px rgba(58,46,46,0.2);
  }
  .modal-close {
    position: absolute; top: 1.2rem; right: 1.2rem;
    background: none; border: none; cursor: pointer;
    font-size: 1.42rem; color: var(--bark-light); transition: color 0.2s;
  }
  .modal-close:hover { color: var(--rose-deep); }
  .modal-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.92rem; font-weight: 300; font-style: italic;
    color: var(--bark); margin-bottom: 0.5rem;
  }
  .modal-divider { width: 40px; height: 1px; background: var(--rose-mid); margin-bottom: 1.2rem; }
  .modal-text { color: var(--bark-light); font-size: 1rem; line-height: 1.8; }

  /* CSS Columns – alle Leistungen */
  .modal-bilder {
    columns: 2;
    column-gap: 1rem;
    margin-top: 1.8rem;
  }
  .col-item {
    break-inside: avoid;
    margin-bottom: 1rem;
  }
  .col-item img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 2px;
  }

  /* Hochzeit: einheitliches Hochformat */
  .modal-bilder[data-leistung="hochzeit"] .col-item img {
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  @media (max-width: 640px) {
    .karten-grid { grid-template-columns: 1fr; }
    .modal-box { padding: 1.8rem; }
    .modal-bilder { columns: 1; }
  }
</style>

<script>
  function loadImages(modal: Element) {
    modal.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => {
      img.src = img.dataset.src!;
      img.removeAttribute('data-src');
    });
  }
  function openModal(id: string) {
    const modal = document.getElementById(`modal-${id}`);
    if (!modal) return;
    loadImages(modal);
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeModal(overlay: Element) {
    overlay.classList.remove('open');
    if (!document.querySelector('.modal-overlay.open')) document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLButtonElement>('.karte').forEach((btn) => {
    btn.addEventListener('click', () => { if (btn.dataset.modal) openModal(btn.dataset.modal); });
  });
  document.querySelectorAll<HTMLButtonElement>('[data-close]').forEach((btn) => {
    btn.addEventListener('click', () => { const o = btn.closest('.modal-overlay'); if (o) closeModal(o); });
  });
  document.querySelectorAll('.modal-overlay').forEach((overlay) => {
    overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(overlay); });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape')
      document.querySelectorAll('.modal-overlay.open').forEach((o) => closeModal(o));
  });
</script>
