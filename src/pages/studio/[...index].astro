---
import { StudioComponent } from '@sanity/astro/studio/studio-component.tsx';
export const prerender = false;

const projectId = import.meta.env.PUBLIC_SANITY_PROJECT_ID;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>Sanity Studio – fein und blumig</title>
    <style>
      body { margin: 0; padding: 0; }
      #auth-overlay {
        position: fixed;
        inset: 0;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        font-family: sans-serif;
        color: #666;
        font-size: 1rem;
      }
    </style>
  </head>
  <body>
    <div id="auth-overlay">Authentifizierung wird geprüft …</div>
    <StudioComponent client:only="react" />
    <script define:vars={{ projectId }}>
      (async () => {
        try {
          const res = await fetch(
            `https://${projectId}.api.sanity.io/v2021-06-07/users/me`,
            { credentials: 'include' }
          );
          if (res.ok) {
            document.getElementById('auth-overlay').remove();
          } else {
            window.location.href =
              'https://www.sanity.io/login?origin=' +
              encodeURIComponent(window.location.href);
          }
        } catch {
          window.location.href =
            'https://www.sanity.io/login?origin=' +
            encodeURIComponent(window.location.href);
        }
      })();
    </script>
  </body>
</html>
