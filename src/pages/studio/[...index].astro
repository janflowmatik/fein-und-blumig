---
import { StudioComponent } from '@sanity/astro/studio/studio-component.tsx';
export const prerender = false;

const configured = true;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>Sanity Studio – fein und blumig</title>
    <style>
      body { margin: 0; padding: 0; }
      .setup-banner {
        background: #f2d5d5; border-bottom: 1px solid #d9a0a0;
        padding: 0.8rem 1.5rem; font-family: sans-serif;
        font-size: 0.9rem; color: #3a2e2e; text-align: center;
      }
      .setup-banner code { background: #fff; padding: 0.1rem 0.4rem; border-radius: 3px; }
    </style>
  </head>
  <body>
    {!configured && (
      <div class="setup-banner">
        ⚙️ Sanity noch nicht verbunden – trage deine Project-ID in <code>.env</code> ein:
        <code>PUBLIC_SANITY_PROJECT_ID=deine_id</code> → Dev-Server neu starten
      </div>
    )}
    <StudioComponent client:only="react" />
  </body>
</html>
